{
  "name": "solussimo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:mobile": "vite build && vite preview --host",
    "test": "vitest run",
    "test:db": "./scripts/test-db.sh",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:secrets",
    "db:migrate": "node scripts/supabase-migrate.mjs",
    "test:api": "node scripts/e2e-supabase-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "i18next": "^27.2.3",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
